{
  "name": "@liuweibing7/dsh-plugin-inspector",
  "version": "1.0.0",
  "type": "module",
  "description": "Inspects a plugin on the Plugins page: its declarative patch entries and the code files installed behind it",
  "license": "MIT",
  "author": "liuweibing7",
  "homepage": "https://github.com/liuweibing7/dsh-plugin-inspector",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuweibing7/dsh-plugin-inspector.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "inspector"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "blocks.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
